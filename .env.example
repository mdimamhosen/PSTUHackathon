# --- Required (Docker Compose sets DB/Redis) ---
DATABASE_URL=postgresql://emergency:emergency@localhost:55432/emergency?schema=public
REDIS_URL=redis://localhost:56379
API_KEY=change-me-demo-api-key
PORT=3000
NODE_ENV=development

# --- Strongly recommended ---
GOOGLE_MAPS_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_EOC_CHAT_ID=

# --- Optional email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@emergency.local

# --- Optional SMS (Twilio trial) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Tuning ---
AGENT_TIMEOUT_MS=15000
EMBEDDING_MODEL=text-embedding-3-small
MAX_QUEUE_DEPTH=5000
WORKER_MODE=false

# Seed scale (scripts/seed.ts + countrycity-js)
# SEED_COUNTRY=BD
# SEED_MAX_REGIONS=0
# SEED_INCIDENTS=120
